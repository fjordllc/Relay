<% content_for :title, @project.name %>

<h1><%= @project.name %></h1>
<p><%= @project.description %></p>

<p>
  <%= link_to "編集", edit_project_path(@project) %> |
  <%= link_to "プロジェクト一覧へ", projects_path %>
</p>

<%# 第26章: 遅延タブ。各タブが共通の tab_content frame を返す %>
<nav aria-label="プロジェクト内の表示" class="tabs">
  <%= link_to "概要", overview_project_path(@project), data: { turbo_frame: "tab_content" } %>
  <%= link_to "タスク", tasklist_project_path(@project), data: { turbo_frame: "tab_content" } %>
</nav>
<%= turbo_frame_tag "tab_content" do %>
  <p>タブを選んでください。</p>
<% end %>
