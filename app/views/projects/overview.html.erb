<%# 第26章: 遅延タブ。共通の tab_content frame を返す %>
<%= turbo_frame_tag "tab_content" do %>
  <h3>概要</h3>
  <p><%= @project.description.presence || "説明はありません。" %></p>
  <p>タスク数: <%= @project.tasks.count %></p>
  <div data-controller="tabs">
    <div role="tablist" aria-label="概要の表示" data-action="keydown->tabs#navigate">
      <button type="button" id="project-tab-summary" role="tab" aria-controls="project-panel-summary" aria-selected="true" tabindex="0" data-tabs-target="tab" data-action="tabs#select">説明</button>
      <button type="button" id="project-tab-chart" role="tab" aria-controls="project-panel-chart" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select">集計</button>
    </div>
    <div id="project-panel-summary" role="tabpanel" aria-labelledby="project-tab-summary" tabindex="0" data-tabs-target="panel">タスク一覧から編集・コメント投稿ができます。</div>
    <div id="project-panel-chart" role="tabpanel" aria-labelledby="project-tab-chart" tabindex="0" data-tabs-target="panel" hidden>
  <%= tag.canvas data: { controller: "chart", chart_counts_value: Task.statuses.keys.map { |status| @project.tasks.where(status: status).count }, action: "turbo:before-cache@document->chart#teardown" }, role: "img", aria: { label: "ステータス別タスク件数" } %>
  <ul>
    <% Task.statuses.keys.each do |status| %>
      <li><%= status %>: <%= @project.tasks.where(status: status).count %> 件</li>
    <% end %>
  </ul>
    </div>
  </div>
<% end %>
