<% content_for :title, @task.title %>

<p><%= link_to "← タスク一覧へ", tasks_path %></p>

<%# 第12章: 表示も一覧と同じ _task（id="task_x" の frame）を使う %>
<%= render @task %>

<%= turbo_stream_from @task, :comments %>
<section class="comments">
  <h2>コメント</h2>
  <div id="<%= dom_id(@task, :comments) %>">
    <%= render @task.comments.includes(:user).order(:created_at) %>
  </div>

  <div id="<%= dom_id(@task, :comment_form) %>">
    <%= render "comments/form", task: @task, comment: @comment %>
  </div>
</section>
